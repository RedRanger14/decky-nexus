+    private static void DumpAssets(FileInfo? inGameFileInfo, string inFilter,
+        FileInfo? inOutput, int? inPid, FileInfo? inKey1, FileInfo? inKey2, FileInfo? inKey3)
+    {
+        if (inGameFileInfo is null || inOutput is null)
+        {
+            Logger.LogErrorInternal("game and output are required.");
+            return;
+        }
+        if (!LoadGame(inGameFileInfo, inPid, inKey1, inKey2, inKey3))
+        {
+            return;
+        }
+
+        static object? Location(Frosty.Sdk.Managers.Entries.AssetEntry entry)
+        {
+            if (entry.GetFileInfo() is not Frosty.Sdk.Managers.Infos.FileInfos.CasFileInfo cas)
+            {
+                return entry.GetFileInfo()?.GetType().Name;
+            }
+            Frosty.Sdk.Managers.Infos.FileInfos.ResourceInfo.CasResourceInfo? b = cas.GetBase();
+            if (b is null)
+            {
+                return null;
+            }
+            return new
+            {
+                file = b.GetIdentifier().ToString(),
+                offset = b.GetFileOffset(),
+                size = b.GetSize(),
+            };
+        }
+
+        List<object> ebx = new(), res = new(), chunks = new();
+        HashSet<int> bundleIds = new();
+
+        foreach (Frosty.Sdk.Managers.Entries.EbxAssetEntry e in AssetManager.EnumerateEbxAssetEntries())
+        {
+            if (!e.Name.Contains(inFilter, StringComparison.OrdinalIgnoreCase))
+            {
+                continue;
+            }
+            foreach (int b in e.EnumerateBundles()) { bundleIds.Add(b); }
+            ebx.Add(new { name = e.Name, sha1 = e.Sha1.ToString(),
+                originalSize = e.OriginalSize, location = Location(e) });
+        }
+
+        foreach (Frosty.Sdk.Managers.Entries.ResAssetEntry e in AssetManager.EnumerateResAssetEntries())
+        {
+            if (!e.Name.Contains(inFilter, StringComparison.OrdinalIgnoreCase))
+            {
+                continue;
+            }
+            foreach (int b in e.EnumerateBundles()) { bundleIds.Add(b); }
+            // The hash of the DECOMPRESSED payload: the only thing that can
+            // prove two packs put the same actual bytes in front of the game,
+            // regardless of codec or level.
+            string rawSha1;
+            try
+            {
+                using Block<byte> raw = AssetManager.GetAsset(e);
+                rawSha1 = Frosty.Sdk.Utils.Utils.GenerateSha1(raw).ToString();
+            }
+            catch (Exception ex)
+            {
+                rawSha1 = $"unreadable: {ex.Message}";
+            }
+            res.Add(new { name = e.Name, sha1 = e.Sha1.ToString(),
+                originalSize = e.OriginalSize, resType = e.Type,
+                resRid = e.ResRid, resMeta = Convert.ToHexString(e.ResMeta),
+                rawSha1,
+                location = Location(e) });
+        }
+
+        // Chunks carry no names: take every chunk that shares a bundle with a
+        // matched asset - for a character that is its meshes and textures.
+        foreach (Frosty.Sdk.Managers.Entries.ChunkAssetEntry e in AssetManager.EnumerateChunkAssetEntries())
+        {
+            bool inMatchedBundle = false;
+            foreach (int b in e.EnumerateBundles())
+            {
+                if (bundleIds.Contains(b)) { inMatchedBundle = true; break; }
+            }
+            if (!inMatchedBundle)
+            {
+                continue;
+            }
+            chunks.Add(new { id = e.Id.ToString(), sha1 = e.Sha1.ToString(),
+                logicalOffset = e.LogicalOffset, logicalSize = e.LogicalSize,
+                location = Location(e) });
+        }
+
+        string json = System.Text.Json.JsonSerializer.Serialize(
+            new { ebx, res, chunks },
+            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
+        File.WriteAllText(inOutput.FullName, json);
+        Logger.LogInfoInternal(
+            $"dumped ebx={ebx.Count} res={res.Count} chunks={chunks.Count} to {inOutput.FullName}");
+    }
