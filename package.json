{
  "name": "decky-nexus",
  "version": "0.42.0",
  "description": "Browse, install, and manage Nexus Mods for the current game \u00e2\u20ac\u201d entirely from Gaming Mode. Decky Loader plugin.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "test": "python -m unittest discover -s tests",
    "test:nav": "tsc src/navRules.ts --outDir .test-build --module es2020 --target es2020 --skipLibCheck --declaration false && node --test tests/nav.test.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:nav"
  },
  "keywords": [
    "decky",
    "plugin",
    "nexus-mods",
    "steam-deck",
    "bazzite",
    "modding"
  ],
  "author": "Michael Finney <michael.finney@nexusmods.com>",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
